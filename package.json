{
  "name": "svg-cli-lab1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Object-oriented SVG CLI editor for Lab1 Phase 1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "npm run build --silent && node dist/src/main.js",
    "test": "npm run build --silent && node --test dist/tests/**/*.test.js",
    "test:unit": "npm run build --silent && node --test dist/tests/unit/*.test.js",
    "test:integration": "npm run build --silent && node --test dist/tests/integration/*.test.js",
    "test:e2e": "npm run build --silent && node --test dist/tests/e2e/*.test.js"
  },
  "dependencies": { "@xmldom/xmldom": "^0.8.11" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.3" }
}
